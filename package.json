{
  "name": "@ramgao/obs-agent-mcp",
  "version": "1.0.2",
  "description": "Give AI agents professional control of OBS Studio: scenes, audio, recording, screenshots, workflows and the complete WebSocket API.",
  "type": "module",
  "license": "MIT",
  "author": "ramgao",
  "repository": {
    "type": "git",
    "url": "https://github.com/ramgao/obs-agent-mcp.git"
  },
  "homepage": "https://github.com/ramgao/obs-agent-mcp#readme",
  "bugs": {
    "url": "https://github.com/ramgao/obs-agent-mcp/issues"
  },
  "bin": {
    "obs-agent-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "obs",
    "obs-studio",
    "ai",
    "agent",
    "streaming",
    "recording"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run check && npm test && npm run build",
    "docs:tools": "tsx scripts/generate-docs.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "obs-websocket-js": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "ws": "^8.18.3",
    "@types/ws": "^8.18.1"
  }
}
